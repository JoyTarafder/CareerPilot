{
  "name": "careerpilot-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "CareerPilot — AI-assisted career platform for ATS-safe resumes and deterministic job matching",
  "workspaces": [
    "frontend/*",
    "backend/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "npm run --workspaces --if-present test",
    "lint": "npm run --workspaces --if-present lint",
    "typecheck": "npm run --workspaces --if-present typecheck",
    "dev:api": "npm run --workspace=backend/api dev",
    "dev:web": "npm run --workspace=frontend/web dev",
    "dev:admin": "npm run --workspace=frontend/admin dev"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2",
    "postcss": "^8.5.28"
  }
}
