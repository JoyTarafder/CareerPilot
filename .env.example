# CareerPilot — Root Environment Template
# Duplicate this file to .env for local development. Never commit .env or real credentials.

# Node Environment & Port
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000

# PostgreSQL Database Connection
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/careerpilot_dev?schema=public

# Security, Sessions & Hashing
# Access token key (min 32 characters in production)
JWT_ACCESS_SECRET=replace-with-a-min-32-character-random-secret
JWT_ACCESS_EXPIRES_IN=10m
REFRESH_TOKEN_EXPIRES_IN=7d
PASSWORD_PEPPER_V1=replace-with-a-high-entropy-server-pepper

# Admin Idempotent Bootstrap (CLI only; never used directly by browser)
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-high-entropy-bootstrap-password

# Google Gemini API (Developer free tier for MVP)
GEMINI_API_KEY=replace-with-gemini-api-key

# Object Storage (Private bucket for resume PDF/DOCX exports)
STORAGE_BUCKET_NAME=careerpilot-private-documents
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=replace-with-storage-key
STORAGE_SECRET_ACCESS_KEY=replace-with-storage-secret

# Frontend Allowed Origins (CORS)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Frontend Public API Target
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
